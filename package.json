{
  "name": "cat-supplies-store",
  "version": "0.0.1",
  "description": "A cat supplies store support application with an AI assistant.",
  "author": "Rafael",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/api/main",
    "lint": "oxlint --type-aware .",
    "typecheck": "tsc --build --pretty false && tsc --noEmit -p tsconfig.check.json && pnpm --filter @cat-supplies-store/web typecheck",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:cov": "vitest run --coverage --config vitest.config.mts",
    "test:debug": "vitest --inspect-brk --no-file-parallelism --config vitest.config.mts",
    "test:e2e": "pnpm --filter @cat-supplies-store/api^... build && vitest run --config apps/api/vitest.config.e2e.mts",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.135",
    "@nestjs/ai": "^0.0.2",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/resilience": "^0.0.3",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/workflows": "^0.0.5",
    "ai": "^7.0.165",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.3.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "husky": "^9.1.7",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "turbo": "^2.8.13",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  }
}
