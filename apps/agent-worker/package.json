{
  "name": "@cat-supplies-store/agent-worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --dir ../.. exec nest build agent-worker",
    "dev": "pnpm --dir ../.. --filter @cat-supplies-store/agent-worker^... build && pnpm --dir ../.. exec nest start agent-worker --watch",
    "start": "node ../../dist/apps/agent-worker/main.js"
  },
  "dependencies": {
    "@cat-supplies-store/ai": "workspace:*",
    "@cat-supplies-store/config": "workspace:*",
    "@cat-supplies-store/contracts": "workspace:*",
    "@cat-supplies-store/database": "workspace:*",
    "@nestjs/ai": "^0.0.2",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/typeorm": "12.0.2",
    "bullmq": "6.5.0",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "1.1.1",
    "zod": "^4.6.7",
    "ioredis": "5.11.1",
    "@cat-supplies-store/refunds": "workspace:*",
    "@cat-supplies-store/workflow-storage": "workspace:*",
    "@nestjs/workflows": "^0.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "typescript": "^6.0.2"
  }
}
