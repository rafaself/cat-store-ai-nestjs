{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "@cat-supplies-store/api#build": {
      "dependsOn": ["^build"],
      "outputs": ["$TURBO_ROOT$/dist/apps/api/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@cat-supplies-store/agent-worker#build": {
      "dependsOn": ["^build"],
      "outputs": ["$TURBO_ROOT$/dist/apps/agent-worker/**"]
    },
    "@cat-supplies-store/agent-api#build": {
      "dependsOn": ["^build"],
      "outputs": ["$TURBO_ROOT$/dist/apps/agent-api/**"]
    }
  }
}
