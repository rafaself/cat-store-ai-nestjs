# GPT-6 Luna is called through the Amazon Bedrock provider.
AWS_REGION=us-east-1
# Set a Bedrock bearer token, or provide AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.
AWS_BEARER_TOKEN_BEDROCK=
DATABASE_URL=postgresql://chatbot:chatbot@127.0.0.1:15432/chatbot
# Demo credentials are disabled when NODE_ENV=production. Keep these local only.
DEMO_CUSTOMER_TOKEN=demo-customer-token-change-me
VITE_DEMO_CUSTOMER_TOKEN=demo-customer-token-change-me
SUPPORT_APPROVAL_TOKEN=demo-support-token-change-me
# Replace with: openssl rand -base64 32. Do not reuse this example key in production.
WORKFLOWS_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
PORT=3000
