# GPT-6 Luna is called through the Amazon Bedrock provider.
AWS_REGION=us-east-1

# Required. Add BEDROCK_MODEL_<UPPERCASE_ALIAS> entries to register more models.
BEDROCK_MODEL_DEFAULT=us.openai.gpt-6-luna
# BEDROCK_MODEL_FAST=<bedrock-model-id>
# BEDROCK_MODEL_FAST_REASONING=<bedrock-model-id>
# Required. Add BEDROCK_EMBEDDING_MODEL_<UPPERCASE_ALIAS> entries for more embeddings.
# The catalog default must produce 1024-dimensional vectors.
BEDROCK_EMBEDDING_MODEL_DEFAULT=amazon.titan-embed-text-v2:0
# BEDROCK_EMBEDDING_MODEL_SEARCH_V2=<bedrock-embedding-model-id>

# Set a Bedrock bearer token, or provide AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.
AWS_BEARER_TOKEN_BEDROCK=
DATABASE_URL=postgresql://chatbot:chatbot@127.0.0.1:15432/chatbot
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
MAILPIT_URL=http://127.0.0.1:18025

# Demo credentials are disabled when NODE_ENV=production. Keep these local only.
DEMO_CUSTOMER_TOKEN=demo-customer-token-change-me
VITE_DEMO_CUSTOMER_TOKEN=demo-customer-token-change-me
SUPPORT_APPROVAL_TOKEN=demo-support-token-change-me

# Replace with: openssl rand -base64 32. Do not reuse this example key in production.
WORKFLOWS_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
PORT=3000
AGENT_API_PORT=3001
BUSINESS_API_URL=http://127.0.0.1:3000

# Optional minimum Nest log level: fatal, error, warn, log, debug, verbose.
# Defaults: development=debug, test=warn, production=log.
# Production logs use JSON; development and test logs use readable text.
# LOG_LEVEL=debug
