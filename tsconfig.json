{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "types": ["node", "vitest/globals"],
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@app/tools": ["./packages/tools/src"],
      "@app/tools/*": ["./packages/tools/src/*"],
      "@app/contract": ["./packages/contract/src"],
      "@app/contract/*": ["./packages/contract/src/*"],
      "@app/database": ["./packages/database/src"],
      "@app/database/*": ["./packages/database/src/*"],
      "@app/shared": ["./packages/shared/src"],
      "@app/shared/*": ["./packages/shared/src/*"],
      "@app/storage": ["./packages/storage/src"],
      "@app/storage/*": ["./packages/storage/src/*"],
      "@app/config": ["./packages/config/src"],
      "@app/config/*": ["./packages/config/src/*"]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/api/tsconfig.app.json"
    },
    {
      "path": "./packages/tools/tsconfig.lib.json"
    },
    { "path": "./packages/contract/tsconfig.json" },
    { "path": "./packages/database/tsconfig.json" },
    { "path": "./packages/shared/tsconfig.json" },
    { "path": "./packages/storage/tsconfig.json" },
    { "path": "./packages/config/tsconfig.json" }
  ]
}
