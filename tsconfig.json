{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "types": ["node", "vitest/globals"],
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false
  },
  "files": [],
  "references": [
    {
      "path": "./packages/tools/tsconfig.lib.json"
    },
    {
      "path": "./packages/contracts/tsconfig.json"
    },
    {
      "path": "./packages/database/tsconfig.json"
    },
    {
      "path": "./packages/shared/tsconfig.json"
    },
    {
      "path": "./packages/workflow-storage/tsconfig.json"
    },
    {
      "path": "./packages/config/tsconfig.json"
    },
    {
      "path": "./apps/api/tsconfig.app.json"
    },
    {
      "path": "./packages/ai/tsconfig.json"
    },
    {
      "path": "./apps/worker/tsconfig.app.json"
    },
    {
      "path": "./packages/refunds/tsconfig.json"
    }
  ]
}
